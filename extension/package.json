{
  "name": "falcon-lens-extension",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "gen": "node scripts/gen-data.mjs",
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs --e2e",
    "zip": "node scripts/build.mjs --zip",
    "typecheck": "node scripts/gen-data.mjs && tsc --noEmit",
    "lint": "node scripts/gen-data.mjs && tsc --noEmit && node scripts/check-static.mjs",
    "test": "node scripts/gen-data.mjs && vitest run",
    "test:e2e": "playwright test",
    "shots": "FL_SHOTS=1 playwright test"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/readex-pro": "5.3.0",
    "@playwright/test": "1.65.1",
    "@types/chrome": "0.3.7",
    "@types/node": "^24",
    "esbuild": "0.28.2",
    "typescript": "^5.9",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
