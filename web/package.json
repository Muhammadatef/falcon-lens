{
  "name": "falcon-web",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/sync-results.mjs && next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "sync:results": "node scripts/sync-results.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm build && pnpm test:e2e"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/readex-pro": "5.3.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8",
    "ajv-formats": "^3",
    "eslint": "^9.39.5",
    "typescript": "^5.9",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
