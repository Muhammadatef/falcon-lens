// Ship container stdout (JSON logs) of the `falcon` compose project to Loki.
discovery.docker "falcon" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=falcon"]
  }
}

discovery.relabel "falcon" {
  targets = discovery.docker.falcon.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "falcon" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.falcon.output
  forward_to = [loki.process.falcon.receiver]
}

loki.process "falcon" {
  // Promote verdict_id from the JSON log line to structured metadata (not a label: high cardinality).
  stage.json {
    expressions = { verdict_id = "verdict_id", level = "level" }
  }
  stage.labels {
    values = { level = "" }
  }
  stage.structured_metadata {
    values = { verdict_id = "" }
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
