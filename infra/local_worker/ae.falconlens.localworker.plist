<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. `make local-worker-install` replaces @REPO@, @UV@ and @HOME@ and writes the result to ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ae.falconlens.localworker</string>
  <key>ProgramArguments</key>
  <array>
    <string>@UV@</string>
    <string>run</string>
    <string>python</string>
    <string>-m</string>
    <string>scripts.local_worker</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key><string>@REPO@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>OLLAMA_BASE_URL</key><string>http://localhost:11434</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>Nice</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@REPO@/work/queue/launchd.out.log</string>
  <key>StandardErrorPath</key><string>@REPO@/work/queue/launchd.err.log</string>
</dict>
</plist>
