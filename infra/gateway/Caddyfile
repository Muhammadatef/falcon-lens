{
	admin off
	auto_https disable_redirects
	skip_install_trust
	servers {
		metrics
	}
}

# Internal plain-HTTP listener: health + metrics for compose/Prometheus only (not published).
http://:8080 {
	handle /healthz {
		respond "ok" 200
	}
	handle /metrics {
		metrics
	}
	handle {
		respond "not found" 404
	}
}

# Public entry point (host 127.0.0.1:8443). Local CA via `tls internal`; the Cloudflare
# tunnel terminates real TLS in front of this for the public demo.
https://localhost:8443 {
	tls internal

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	request_body {
		max_size 6MB
	}

	# CSP: the web app sets its own per-request nonce policy (web/proxy.ts: no 'unsafe-inline',
	# no 'unsafe-eval'), so the gateway must not add a second one on web routes. API and MCP
	# answers are data, never documents: they get a deny-all policy here.
	handle /v1/* {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy api:8000
	}
	handle /mcp* {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy mcp:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
