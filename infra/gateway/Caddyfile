{
	admin off
	auto_https disable_redirects
	skip_install_trust
	servers {
		metrics
		# Behind the cloudflared tunnel every request arrives from a private (docker/host) address.
		# Trust only private ranges and take the real caller from Cloudflare's header, so the API's
		# per-IP rate limit sees one bucket per visitor, not one for the whole tunnel.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

# Internal plain-HTTP listener: health + metrics for compose/Prometheus only (not published).
http://:8080 {
	handle /healthz {
		respond "ok" 200
	}
	handle /metrics {
		metrics
	}
	handle {
		respond "not found" 404
	}
}

# Public entry point (host 127.0.0.1:8443). Local CA via `tls internal`; the Cloudflare
# tunnel terminates real TLS in front of this for the public demo.
https://localhost:8443 {
	tls internal

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# "?" = default only: the web app sets its own per-page policy (microphone=(self) on /voice only), so an
		# upstream value must win; API, MCP and static answers have none and get this deny-all default.
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	request_body {
		max_size 6MB
	}

	# CSP: the web app sets its own per-request nonce policy (web/proxy.ts: no 'unsafe-inline',
	# no 'unsafe-eval'), so the gateway must not add a second one on web routes. API and MCP
	# answers are data, never documents: they get a deny-all policy here.
	handle /v1/* {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {client_ip}
			# The API trusts only this header (and only from the gateway peer). header_up with a
			# value replaces anything the client sent, so it cannot be spoofed.
			header_up X-Falcon-Client-IP {client_ip}
		}
	}
	handle /mcp* {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy mcp:8000
	}
	handle {
		# Paths the app's CSP proxy does not match (static files, /api/health, their 404 pages)
		# still get a policy: `?` sets it only when the app did not, so there is always exactly one.
		header ?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		# The share target (/share) starts checks on the API from the web container and forwards
		# this header, so it must carry the real visitor, exactly as on /v1 (per-visitor rate limit).
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Falcon-Client-IP {client_ip}
		}
	}
}
