{
  "uid": "fl-detection-quality",
  "title": "Detection quality | جودة الكشف",
  "tags": [
    "falcon-lens",
    "quality"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "style": "dark",
  "links": [
    {
      "title": "Command overview | مركز القيادة",
      "type": "link",
      "url": "/d/fl-command-overview",
      "icon": "dashboard",
