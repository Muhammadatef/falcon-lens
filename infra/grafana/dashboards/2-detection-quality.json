    {
      "type": "stat",
      "title": "Data source | مصدر البيانات",
      "description": "REPLAY when any fl_checks_total{source=\"replay\"} was recorded in the last 5 minutes. Replayed or synthetic data is never presented as live. Counters without a source label (LLM, sandbox, security) include replayed traffic while the banner says REPLAY. Thresholds: green = LIVE only, orange = replayed data present (a label, not a fault). No data: no check was recorded at all; the panel then reads LIVE.",
      "links": [],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_max(sum(increase(fl_checks_total{source=\"replay\"}[5m])), 1) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3FB68B",
                "value": null
              },
              {
                "color": "#F5A623",
                "value": 1
              }
            ]
          },
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "REPLAY DATA ACTIVE | بيانات إعادة تشغيل",
                  "color": "#F5A623",
                  "index": 0
                },
                "0": {
                  "text": "LIVE | مباشر",
                  "color": "#3FB68B",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "text",
      "title": "Where these numbers come from | مصدر الأرقام",
      "options": {
        "mode": "markdown",
        "content": "Live panels count what the cascade did (hard rules, evidence, tiers). Offline model scores with confidence intervals are on **Model quality** and come from published eval artifacts only. Nothing is typed in by hand; REPLAY traffic is marked."
      },
      "transparent": true,
      "id": 2,
      "gridPos": {
        "h": 3,
        "w": 16,
        "x": 8,
        "y": 0
      }
