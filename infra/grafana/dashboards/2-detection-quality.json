    },
    {
      "title": "Detection quality | جودة الكشف",
      "type": "link",
      "url": "/d/fl-detection-quality",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Pipeline performance | أداء المسار",
      "type": "link",
      "url": "/d/fl-pipeline",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "AI operations | عمليات الذكاء الاصطناعي",
      "type": "link",
      "url": "/d/fl-ai-ops",
      "icon": "dashboard",
