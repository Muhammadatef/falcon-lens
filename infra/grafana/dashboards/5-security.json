    {
      "type": "logs",
      "title": "Security log lines | سجلات أمنية",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\".+\"} |~ \"(?i)ssrf|injection|canary|blocked|auth\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "id": 12,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 19
      }
