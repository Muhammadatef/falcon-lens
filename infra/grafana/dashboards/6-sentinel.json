  "panels": [
    {
      "type": "stat",
      "title": "Data source | مصدر البيانات",
      "description": "REPLAY when any fl_checks_total{source=\"replay\"} was recorded in the last 5 minutes. Replayed or synthetic data is never presented as live. Counters without a source label (LLM, sandbox, security) include replayed traffic while the banner says REPLAY. Thresholds: green = LIVE only, orange = replayed data present (a label, not a fault). No data: no check was recorded at all; the panel then reads LIVE.",
      "links": [],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_max(sum(increase(fl_checks_total{source=\"replay\"}[5m])), 1) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3FB68B",
                "value": null
              },
              {
                "color": "#F5A623",
                "value": 1
              }
            ]
          },
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "REPLAY DATA ACTIVE | بيانات إعادة تشغيل",
                  "color": "#F5A623",
                  "index": 0
                },
                "0": {
                  "text": "LIVE | مباشر",
                  "color": "#3FB68B",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Event lag | تأخر الأحداث",
      "description": "Age of the oldest unprocessed bus event. Thresholds: green < 30 s, amber 30-60 s, red >= 60 s (SentinelLag fires above 60 s). No data: the Sentinel has not processed events in this range (no incidents yet, or the service is down).",
      "links": [
        {
          "title": "Runbook: sentinel-lag",
          "url": "https://github.com/Muhammadatef/falcon-lens/blob/main/docs/RUNBOOK.md#sentinel-lag",
          "targetBlank": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(fl_event_lag_seconds)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": ""
