        "y": 6
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Incidents opened by type | الحوادث حسب النوع | REPLAY-aware",
      "description": "Incidents created per 5 min by type, severity and source. Thresholds: none: counts; a new high severity fires NewHighIncident. No data: the Sentinel has not processed events in this range (no incidents yet, or the service is down). Series with source=replay are drawn dashed orange and labelled REPLAY.",
      "links": [
        {
          "title": "Runbook: campaign-surge",
          "url": "https://github.com/Muhammadatef/falcon-lens/blob/main/docs/RUNBOOK.md#campaign-surge",
          "targetBlank": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(label_replace(sum by (type, severity, source) (increase(fl_incidents_total[5m])), \"source\", \"REPLAY\", \"source\", \"replay\"), \"source\", \"LIVE\", \"source\", \"live\")",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{type}} · {{severity}} · {{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*REPLAY.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F5A623"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*LIVE.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3FB68B"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 7
      }
    },
