    {
      "type": "timeseries",
      "title": "Time to incident p50 / p95 | الزمن حتى الحادثة",
      "description": "Seconds from the triggering event to the incident (live source only). Thresholds: dashed line at 60 s: amber above, an incident older than a minute is late for a demo. No data: the Sentinel has not processed events in this range (no incidents yet, or the service is down).",
      "links": [],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(fl_time_to_incident_seconds_bucket[10m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fl_time_to_incident_seconds_bucket[10m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p95"
        }
