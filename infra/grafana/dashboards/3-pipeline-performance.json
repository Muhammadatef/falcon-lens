    {
      "type": "timeseries",
      "title": "Stage latency p50 | زمن المرحلة",
      "description": "p50 per stage (T0-T3 and total). Thresholds: dashed line at 8 s (end-to-end objective). No data: no checks ran in this time range; run make seed, make replay or make demo, or send a real check.",
      "links": [
        {
          "title": "Runbook: latency-burn",
          "url": "https://github.com/Muhammadatef/falcon-lens/blob/main/docs/RUNBOOK.md#latency-burn",
          "targetBlank": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, stage) (rate(fl_stage_latency_seconds_bucket[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
