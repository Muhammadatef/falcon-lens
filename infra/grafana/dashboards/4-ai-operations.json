    {
      "type": "stat",
      "title": "LLM spend, 1 h | تكلفة النماذج",
      "description": "Estimated cloud spend from token counts and the price table (local route costs 0). Thresholds: none: no budget is set in the repo. No data: the AI tiers made no call in this range (T3/extractor/Sentinel idle, or the stack runs without AI).",
      "links": [],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(fl_llm_cost_usd_total[1h])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
