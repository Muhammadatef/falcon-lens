    {
      "type": "stat",
      "title": "Cost / 1k checks | تكلفة لكل ألف فحص",
      "description": "Estimated LLM spend divided by checks, per 1000 checks. Thresholds: none: no budget is set in the repo. No data: the AI tiers made no call in this range (T3/extractor/Sentinel idle, or the stack runs without AI).",
      "links": [],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * (sum(increase(fl_llm_cost_usd_total[1h])) or vector(0)) / clamp_min(sum(increase(fl_checks_total[1h])), 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
