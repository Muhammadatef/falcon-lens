  "panels": [
    {
      "type": "stat",
      "title": "Data source | مصدر البيانات",
      "description": "REPLAY when any fl_checks_total{source=\"replay\"} was recorded in the last 5 minutes. Replayed or synthetic data is never presented as live. Counters without a source label (LLM, sandbox, security) include replayed traffic while the banner says REPLAY. Thresholds: green = LIVE only, orange = replayed data present (a label, not a fault). No data: no check was recorded at all; the panel then reads LIVE.",
      "links": [],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_max(sum(increase(fl_checks_total{source=\"replay\"}[5m])), 1) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3FB68B",
                "value": null
              },
              {
                "color": "#F5A623",
                "value": 1
              }
            ]
          },
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "REPLAY DATA ACTIVE | بيانات إعادة تشغيل",
                  "color": "#F5A623",
                  "index": 0
                },
                "0": {
                  "text": "LIVE | مباشر",
                  "color": "#3FB68B",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "text",
      "title": "Traces | التتبع",
      "options": {
        "mode": "markdown",
        "content": "LLM spans (OpenInference) go collector -> **Phoenix**. Filter by `verdict_id` to join a trace with its logs (Loki) and these metrics. The LLM never sets a score: the arbiter does."
      },
      "transparent": true,
      "id": 2,
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 8,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Canary leaks, 1 h | تسرب الكناري",
      "description": "A canary token seen in model output means prompt exfiltration. Must stay 0. Thresholds: green 0, red >= 1: any leak is an incident. No data: nothing of this kind happened in this range, which is the healthy state; the series appears at the first event.",
      "links": [
        {
          "title": "Runbook: canary-leak",
          "url": "https://github.com/Muhammadatef/falcon-lens/blob/main/docs/RUNBOOK.md#canary-leak",
          "targetBlank": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(fl_canary_leak_total[1h]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3FB68B",
                "value": null
              },
              {
                "color": "#E5484D",
                "value": 1
              }
            ]
          },
          "noValue": "0 (series appears at the first leak)"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "id": 3,
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 16,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Forbidden-tool attempts, 1 h | محاولات أدوات ممنوعة",
      "description": "Investigator tool calls the registry blocked: an unlisted tool or a URL/domain not from the evidence chain. Blocked, but must stay 0 on live traffic. Thresholds: green 0, red >= 1 (expected under red-team replay: check the banner). No data: nothing of this kind happened in this range, which is the healthy state; the series appears at the first event.",
      "links": [
        {
          "title": "Runbook: injection-spike",
          "url": "https://github.com/Muhammadatef/falcon-lens/blob/main/docs/RUNBOOK.md#injection-spike",
          "targetBlank": true
