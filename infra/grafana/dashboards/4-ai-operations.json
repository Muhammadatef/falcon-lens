    {
      "id": 7,
      "type": "row",
      "title": "Per role | لكل دور",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Role scorecard, last hour | بطاقة الأدوار",
      "description": "One row per LLM role (extractor, investigator, responder...): call rate, latency, share of provider calls that failed or timed out, and share of requests that ended on the caller's template. Thresholds: failure and template above 10% are worth a look (heuristic); LLMFallbackActive fires on cloud->local fallback. No data: the AI tiers made no call in this range (T3/extractor/Sentinel idle, or the stack runs without AI).",
      "links": [
        {
          "title": "Runbook: llm-fallback",
          "url": "https://github.com/Muhammadatef/falcon-lens/blob/main/docs/RUNBOOK.md#llm-fallback",
          "targetBlank": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (role) (rate(fl_llm_calls_total[5m])) * 60",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le, role) (rate(fl_llm_call_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le, role) (rate(fl_llm_call_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "sum by (role) (increase(fl_llm_calls_total{outcome!=\"ok\"}[1h])) / clamp_min(sum by (role) (increase(fl_llm_calls_total[1h])), 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "fl:llm_template_ratio:increase1h",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "role",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(role|Value.*)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true
            },
            "renameByName": {
              "Value #A": "calls/min",
              "Value #B": "p50 s",
              "Value #C": "p95 s",
              "Value #D": "failure %",
              "Value #E": "template %"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50 s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failure %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "template %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 7
      }
    },
    {
