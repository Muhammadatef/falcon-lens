# ───────────── Falcon Lens | عدسة الصقر — environment ─────────────
# Copy to .env. Every variable is optional unless marked REQUIRED; missing
# keys switch the related feature off and the dashboards show it as disabled.

# --- Runtime mode ---
# local | demo | ci
FL_ENV=local
# true = every LLM call goes to the local model; no content leaves the machine
FL_SOVEREIGN_MODE=false
# set to the cloudflared tunnel URL for the public demo
FL_PUBLIC_BASE_URL=https://localhost:8443
# READ-scope API key used ONLY by the web server (Next.js route handlers /api/public/campaigns*) to feed
# the public /campaigns board. Never sent to browsers, never logged. Mint it with:
#   docker compose exec api python /app/scripts/create_api_key.py --label web-public-board --scopes read --rate-limit 600
# (printed once; paste it here). Empty = the board shows "not connected".
FL_WEB_READ_KEY=

# --- Second stack on the same machine: COMPOSE_PROJECT_NAME=falcon-mcp plus remapped ports below ---
# COMPOSE_PROJECT_NAME=falcon-mcp
# --- Host ports (all bound to 127.0.0.1; change them to run a second stack in parallel) ---
FL_GATEWAY_PORT=8443
FL_PROMETHEUS_PORT=9090
FL_GRAFANA_PORT=3001

# --- Cloud LLM (Anthropic) — product runtime, NOT the Claude CLI login ---
# empty => local-only mode (same as sovereign)
ANTHROPIC_API_KEY=
FL_CLOUD_MODEL_INVESTIGATOR=claude-sonnet-5-5
FL_CLOUD_MODEL_VISION=claude-sonnet-5-5
FL_CLOUD_MODEL_EXTRACTOR=claude-haiku-5-5
FL_CLOUD_MODEL_RESPONDER=claude-haiku-5-5
FL_LLM_TIMEOUT_S=12
# Share (0..1) of LLM calls also sent to the other route, to measure route agreement. Cloud only when enabled.
FL_SHADOW_RATE=0

# --- Local LLM (Ollama on the host or another machine) ---
# e.g. http://mirai:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# see infra/ollama/README.md and ADR-003
FL_LOCAL_MODEL=inkling-2-mini-chat
FL_LOCAL_VISION_MODEL=gemma3:27b
# L4 bulk jobs via scripts/qwen_task.py
FL_LOCAL_WORKER_MODEL=qwen3:4b
FL_EMBED_MODEL=qwen3-embedding:4b
FL_EMBED_DIM=2560
# Timeout for local LLM calls, in seconds (a cold model load is slow).
FL_LOCAL_LLM_TIMEOUT_S=60
# Path to data/brands.yaml. Set it in containers; leave empty to search upward from the package.
FL_BRANDS_PATH=

# --- Reputation feeds ---
# empty => feed disabled
GOOGLE_SAFE_BROWSING_API_KEY=
# empty => feed disabled
URLHAUS_AUTH_KEY=
# community feed; respect its terms (docs/DECISIONS)
FL_FEED_OPENPHISH_ENABLED=true

# --- Data stores ---
POSTGRES_USER=falcon
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=falcon
DATABASE_URL=postgresql://falcon:change-me-local-only@postgres:5432/falcon
REDIS_URL=redis://redis:6379/0

# --- API auth ---
# used to hash API keys at rest
FL_API_KEY_PEPPER=change-me
# public sandbox key for judges (low rate limit)
FL_SANDBOX_API_KEY=fl_sandbox_demo_key
FL_SANDBOX_URL=http://sandbox:8000
# Demo/test fixture hosts exempt from SSRF name checks (internal Falcon Demo Bank fixtures only).
# Read by the worker, the sandbox and (as FL_EGRESS_ALLOW_HOSTS, same list) the egress proxy. Each one honours it
# ONLY when FL_ENV is local, demo or ci; any other or missing FL_ENV ignores it (fail closed, logged).
FL_SSRF_ALLOW_HOSTS=fixtures,falcon-demo-bank.test,falcon-demo-bank-secure.test,falcon-demo-bank-login.test,falcon-demo-bank-cloak.test,falcon-demo-bank-injection.test,falcon-bot-relay.test
FL_SMOKE_OFFICIAL_URL=http://falcon-demo-bank.test/
FL_SMOKE_PHISH_URL=http://falcon-demo-bank-secure.test/login
# approve/reject Sentinel external actions
FL_OPERATOR_KEY=change-me-operator
FL_MCP_BEARER_TOKEN=change-me-mcp
FL_WEBHOOK_SECRET=change-me-webhook
# comma-separated https URLs that receive signed campaign alerts (empty = off)
FL_WEBHOOK_TARGETS=
# key the MCP server uses against the REST API (scopes: check, read only)
FL_MCP_SERVICE_KEY=change-me-mcp-service
# shared secret: worker -> sandbox service (internal network only)
FL_SANDBOX_TOKEN=change-me-sandbox
FL_RATE_LIMIT_PER_IP_PER_MIN=60

# --- Alerts ---
# empty => alerts stay in Grafana + logs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# --- Observability ---
GRAFANA_ADMIN_PASSWORD=change-me
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Arize Phoenix (LLM / agent traces; UI on 127.0.0.1:FL_PHOENIX_PORT, login required) ---
# Generate each value with:  python3 -c "import secrets;print(secrets.token_urlsafe(36))"
# Never commit real values. PHOENIX_SECRET and PHOENIX_ADMIN_SECRET must differ, be >= 32 characters
# and contain a digit and a lowercase letter.
FL_PHOENIX_PORT=6006
# signs login tokens (without it Phoenix refuses to start)
PHOENIX_SECRET=
# bearer token the otel-collector uses to send spans (optional: a system API key from the UI may go
# in PHOENIX_API_KEY instead and takes precedence)
PHOENIX_ADMIN_SECRET=
PHOENIX_API_KEY=
# password of admin@localhost, applied only while it is still the default "admin". On an existing
# volume that was already changed, set it in the UI (Settings), or reset: stop phoenix, then
# `docker volume rm <project>_phoenix_data` (this deletes all stored traces) and start again.
PHOENIX_ADMIN_INITIAL_PASSWORD=
