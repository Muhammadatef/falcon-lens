# ───────────── Falcon Lens | عدسة الصقر — environment ─────────────
# Copy to .env. Every variable is optional unless marked REQUIRED; missing
# keys switch the related feature off and the dashboards show it as disabled.

# --- Runtime mode ---
FL_ENV=local                       # local | demo | ci
FL_SOVEREIGN_MODE=false            # true = every LLM call goes to the local model; no content leaves the machine
FL_PUBLIC_BASE_URL=https://localhost:8443   # set to the cloudflared tunnel URL for the public demo

# --- Cloud LLM (Anthropic) — product runtime, NOT the Claude CLI login ---
ANTHROPIC_API_KEY=                 # empty => local-only mode (same as sovereign)
FL_CLOUD_MODEL_INVESTIGATOR=claude-sonnet-5-5
FL_CLOUD_MODEL_VISION=claude-sonnet-5-5
FL_CLOUD_MODEL_EXTRACTOR=claude-haiku-5-5
FL_CLOUD_MODEL_RESPONDER=claude-haiku-5-5
FL_LLM_TIMEOUT_S=12

# --- Local LLM (Ollama on the host or another machine) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434   # e.g. http://mirai:11434
FL_LOCAL_MODEL=gemma3:27b          # see docs/adr/ADR-003-local-model.md
FL_LOCAL_VISION_MODEL=gemma3:27b
FL_LOCAL_WORKER_MODEL=qwen3:4b     # L4 bulk jobs via scripts/qwen_task.py
FL_EMBED_MODEL=qwen3-embedding:4b
FL_EMBED_DIM=2560

# --- Reputation feeds ---
GOOGLE_SAFE_BROWSING_API_KEY=      # empty => feed disabled
URLHAUS_AUTH_KEY=                  # empty => feed disabled
FL_FEED_OPENPHISH_ENABLED=true     # community feed; respect its terms (docs/DECISIONS)

# --- Data stores ---
POSTGRES_USER=falcon
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=falcon
DATABASE_URL=postgresql://falcon:change-me-local-only@postgres:5432/falcon
REDIS_URL=redis://redis:6379/0

# --- API auth ---
FL_API_KEY_PEPPER=change-me        # used to hash API keys at rest
FL_SANDBOX_API_KEY=fl_sandbox_demo_key   # public sandbox key for judges (low rate limit)
FL_OPERATOR_KEY=change-me-operator      # approve/reject Sentinel external actions
FL_MCP_BEARER_TOKEN=change-me-mcp
FL_WEBHOOK_SECRET=change-me-webhook
FL_RATE_LIMIT_PER_IP_PER_MIN=60

# --- Alerts ---
TELEGRAM_BOT_TOKEN=                # empty => alerts stay in Grafana + logs
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# --- Observability ---
GRAFANA_ADMIN_PASSWORD=change-me
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
