{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falcon-lens.local/contracts/campaign.schema.json",
  "title": "Campaign",
  "description": "Small campaign card served by GET /v1/campaigns and SSE /v1/campaigns/stream. A projection of an Incident of type campaign or kit_reuse, computed by the API; it carries defanged/aggregate data only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_id", "brand_id", "title_ar", "title_en", "severity", "count", "first_seen", "last_seen", "series", "advice_ar", "advice_en"],
  "properties": {
    "campaign_id": { "type": "string", "pattern": "^cmp_[0-9A-HJKMNP-TV-Z]{26}$" },
    "brand_id": { "type": ["string", "null"] },
    "title_ar": { "type": "string" },
    "title_en": { "type": "string" },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "count": { "type": "integer", "minimum": 0, "description": "Number of linked domains/URLs." },
    "first_seen": { "type": "string", "format": "date-time" },
    "last_seen": { "type": "string", "format": "date-time" },
    "series": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "type": "integer", "minimum": 0 }, "description": "Indicator first-seen counts in 12 equal time buckets between the first and last indicator." },
    "advice_ar": { "type": "string" },
    "advice_en": { "type": "string" },
    "incident_id": { "type": "string", "pattern": "^inc_[0-9A-HJKMNP-TV-Z]{26}$" },
    "source": { "type": "string", "enum": ["live", "replay", "synthetic", "fixture"], "description": "Replayed or synthetic data stays labelled." }
  }
}
